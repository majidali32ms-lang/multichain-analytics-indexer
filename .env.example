# Copy to .env and set only what you need. Everything here is optional.
# Endpoint URLs are treated as secrets because hosted providers often put an API
# key in them. They are never logged.

# Algorand Indexer endpoints. Defaults: Nodely's free tier (no token needed) for
# testnet and mainnet, and AlgoKit LocalNet's http://localhost:8980 for localnet.
# ALGORAND_TESTNET_INDEXER_SERVER=https://your-testnet-indexer.example
# ALGORAND_TESTNET_INDEXER_TOKEN=your-token
# ALGORAND_MAINNET_INDEXER_SERVER=https://your-mainnet-indexer.example
# ALGORAND_MAINNET_INDEXER_TOKEN=your-token
# ALGORAND_LOCALNET_INDEXER_SERVER=http://localhost:8980
# ALGORAND_LOCALNET_INDEXER_TOKEN=your-token

# Solana RPC endpoints. Defaults: the public endpoints for devnet, testnet and mainnet,
# and solana-test-validator's http://localhost:8899 for localnet.
# SOLANA_DEVNET_RPC_SERVER=https://your-devnet-rpc.example
# SOLANA_MAINNET_RPC_SERVER=https://your-mainnet-rpc.example
# Commitment: confirmed (default) or finalized.
# SOLANA_DEVNET_COMMITMENT=confirmed

# NEAR JSON-RPC endpoints, for account state and access keys. Defaults: dRPC's public
# endpoints for testnet and mainnet, and the NEAR sandbox's http://localhost:3030 for localnet.
# NEAR_TESTNET_RPC_SERVER=https://your-testnet-rpc.example
# NEAR_MAINNET_RPC_SERVER=https://your-mainnet-rpc.example

# NEAR account history. The RPC cannot list it, so an indexing service does.
# The service to use. Only fastnear is built in.
# NEAR_TESTNET_HISTORY_SOURCE=fastnear
# Optional. FastNEAR answers without a key today, but its docs ask for one on every request.
# NEAR_TESTNET_HISTORY_API_KEY=your-key
# NEAR_MAINNET_HISTORY_API_KEY=your-key
# NEAR_TESTNET_HISTORY_SERVER=https://your-history-service.example
# Which transactions a sync keeps: direct (default), those the account signed or received,
# as NearBlocks lists them; or all, which also keeps those where the account only received a
# receipt or is named in an action's arguments or an event log. Use a new database after
# changing it.
# NEAR_TESTNET_HISTORY_SCOPE=direct

# Local database. Default: indexer.db in ~/.multichain-indexer
# MCI_DATABASE=./indexer.db

# Response cache for data that can never change. Off unless a path is set.
# MCI_CACHE_PATH=./cache.db

# Network behaviour.
# Defaults to 10 on Algorand, 0.5 on Solana, and on NEAR 1 for the RPC and 0.5 for history.
# The Solana and NEAR figures were measured against their public endpoints. This one setting
# replaces all of them, so raise it on a dedicated endpoint.
# MCI_REQUESTS_PER_SECOND=10
# MCI_REQUEST_TIMEOUT=20
# MCI_MAX_RETRIES=4
