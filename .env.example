# Copy to .env and set only what you need. Everything here is optional.
# Endpoint URLs are treated as secrets because hosted providers often put an API
# key in them. They are never logged.

# Algorand Indexer endpoints. Defaults: Nodely's free tier (no token needed) for
# testnet and mainnet, and AlgoKit LocalNet's http://localhost:8980 for localnet.
# ALGORAND_TESTNET_INDEXER_SERVER=https://your-testnet-indexer.example
# ALGORAND_TESTNET_INDEXER_TOKEN=your-token
# ALGORAND_MAINNET_INDEXER_SERVER=https://your-mainnet-indexer.example
# ALGORAND_MAINNET_INDEXER_TOKEN=your-token
# ALGORAND_LOCALNET_INDEXER_SERVER=http://localhost:8980
# ALGORAND_LOCALNET_INDEXER_TOKEN=your-token

# Local database. Default: indexer.db in ~/.multichain-indexer
# MCI_DATABASE=./indexer.db

# Response cache for data that can never change. Off unless a path is set.
# MCI_CACHE_PATH=./cache.db

# Network behaviour.
# MCI_REQUESTS_PER_SECOND=10
# MCI_REQUEST_TIMEOUT=20
# MCI_MAX_RETRIES=4
